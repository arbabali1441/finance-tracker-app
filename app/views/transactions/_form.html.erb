<div class="max-w-xl mx-auto">
  <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100">
    <h2 class="text-2xl font-extrabold text-slate-900 mb-6">Transaction Details</h2>
    <%= form_with(model: transaction, local: true, class: "space-y-5") do |form| %>
      <% if transaction.errors.any? %>
        <div class="bg-rose-50 border border-rose-200 text-rose-700 p-4 rounded-xl text-sm">
          <h2 class="font-bold mb-1"><%= pluralize(transaction.errors.count, "error") %> prohibited this transaction:</h2>
          <ul class="list-disc pl-5 space-y-1">
            <% transaction.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :title, class: "block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2" %>
        <%= form.text_field :title, placeholder: "e.g., Client Payment, Grocery", class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm" %>
      </div>

      <div>
        <%= form.label :amount, class: "block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2" %>
        <%= form.number_field :amount, step: "0.01", placeholder: "0.00", class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm" %>
      </div>

      <div>
        <%= form.label :category, class: "block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2" %>
        <%= form.text_field :category, placeholder: "e.g., Salary, Software, Food", class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm" %>
      </div>

      <div>
        <%= form.label :transaction_type, "Type", class: "block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2" %>
        <%= form.select :transaction_type, options_for_select([["Income", "Income"], ["Expense", "Expense"]], transaction.transaction_type), {}, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm bg-white" %>
      </div>

      <div>
        <%= form.label :date, class: "block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2" %>
        <%= form.date_field :date, class: "w-full rounded-xl border border-slate-200 px-4 py-2.5 text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm" %>
      </div>

      <div class="flex items-center justify-between pt-4">
        <%= link_to "Cancel", transactions_path, class: "text-slate-500 hover:text-slate-800 text-sm font-medium" %>
        <%= form.submit "Save Transaction", class: "bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2.5 rounded-xl font-semibold shadow-md transition duration-200 text-sm cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

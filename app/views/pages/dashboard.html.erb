<div class="max-w-7xl mx-auto px-6 py-8 space-y-8">
  
  <!-- HERO BANNER & LIQUIDITY METRICS -->
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <div class="lg:col-span-3 p-8 rounded-3xl bg-gradient-to-r from-slate-900 via-indigo-950/40 to-slate-900 border border-slate-800 shadow-2xl flex flex-col justify-between space-y-6">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-[10px] font-bold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> WealthPulse Pro Live Engine
        </div>
        <h1 class="text-3xl font-black text-white">Welcome back, <%= @user.name %>
        <p class="text-slate-400 text-xs">Your real-time multi-currency liquidity, expense velocity, and risk models are fully synchronized.</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-slate-800/80 font-mono">
        <div>
          <p class="text-[10px] text-slate-400 uppercase tracking-wider">Net Worth</p>
          <p class="text-lg font-bold text-white">$<%= sprintf('%.2f', @net_worth.to_f) %></p>
        </div>
        <div>
          <p class="text-[10px] text-slate-400 uppercase tracking-wider">Monthly Cash Flow</p>
          <p class="text-lg font-bold text-emerald-400">+$<%= sprintf('%.2f', @cash_flow.to_f) %></p>
        </div>
        <div>
          <p class="text-[10px] text-slate-400 uppercase tracking-wider">Runway</p>
          <p class="text-lg font-bold text-indigo-400"><%= @runway %></p>
        </div>
        <div>
          <p class="text-[10px] text-slate-400 uppercase tracking-wider">Health Score</p>
          <p class="text-lg font-bold text-amber-400"><%= @health_score %></p>
        </div>
      </div>
    </div>

    <!-- QUICK COMMAND CENTER -->
    <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 flex flex-col justify-between space-y-4">
      <h3 class="text-xs font-bold text-slate-300 uppercase tracking-wider">Quick Tools</h3>
      <div class="space-y-2.5">
        <a href="/budgets" class="w-full py-3 px-4 rounded-xl bg-indigo-600/20 border border-indigo-500/30 text-indigo-300 font-bold text-xs flex items-center justify-between hover:bg-indigo-600/30 transition shadow-lg">
          <span>Manage Budgets</span> <i class="fa-solid fa-piggy-bank"></i>
        </a>
        <button onclick="openWalletModal()" class="w-full py-3 px-4 rounded-xl bg-emerald-600/20 border border-emerald-500/30 text-emerald-300 font-bold text-xs flex items-center justify-between hover:bg-emerald-600/30 transition shadow-lg cursor-pointer">
          <span>Add New Vault</span> <i class="fa-solid fa-vault"></i>
        </button>
        <a href="/export_statement" class="w-full py-3 px-4 rounded-xl bg-slate-950 border border-slate-800 text-slate-300 font-bold text-xs flex items-center justify-between hover:bg-slate-800 transition">
          <span>Export CSV Statement</span> <i class="fa-solid fa-file-arrow-down text-indigo-400"></i>
        </a>
      </div>
    </div>
  </div>

  <!-- VISUAL ANALYTICS & CHARTS SECTION -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- CASH FLOW TREND CHART CARD -->
    <div class="lg:col-span-2 p-6 rounded-3xl bg-slate-900/60 border border-slate-800 space-y-4">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="font-bold text-white text-sm flex items-center gap-2">
          <i class="fa-solid fa-chart-line text-indigo-400"></i> Cash Flow Velocity (6 Months)
        </h3>
        <span class="text-[10px] font-bold text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-full border border-emerald-500/20">+14.2% Growth</span>
      </div>
      <!-- Mock Visual Bar Analytics Graphic -->
      <div class="h-48 flex items-end justify-between gap-3 pt-6 px-4">
        <div class="w-full bg-slate-950 rounded-t-xl h-[45%] flex flex-col justify-end items-center pb-2 relative group">
          <div class="w-full bg-indigo-600/60 rounded-t-lg h-[80%]"></div>
          <span class="text-[10px] text-slate-500 mt-2 font-mono">May</span>
        </div>
        <div class="w-full bg-slate-950 rounded-t-xl h-[65%] flex flex-col justify-end items-center pb-2 relative group">
          <div class="w-full bg-indigo-600/80 rounded-t-lg h-[90%]"></div>
          <span class="text-[10px] text-slate-500 mt-2 font-mono">Jun</span>
        </div>
        <div class="w-full bg-slate-950 rounded-t-xl h-[55%] flex flex-col justify-end items-center pb-2 relative group">
          <div class="w-full bg-indigo-600 rounded-t-lg h-[70%]"></div>
          <span class="text-[10px] text-slate-500 mt-2 font-mono">Jul</span>
        </div>
        <div class="w-full bg-slate-950 rounded-t-xl h-[85%] flex flex-col justify-end items-center pb-2 relative group">
          <div class="w-full bg-indigo-500 rounded-t-lg h-[95%]"></div>
          <span class="text-[10px] text-slate-500 mt-2 font-mono">Aug</span>
        </div>
        <div class="w-full bg-slate-950 rounded-t-xl h-[70%] flex flex-col justify-end items-center pb-2 relative group">
          <div class="w-full bg-indigo-600/90 rounded-t-lg h-[85%]"></div>
          <span class="text-[10px] text-slate-500 mt-2 font-mono">Sep</span>
        </div>
        <div class="w-full bg-slate-950 rounded-t-xl h-[95%] flex flex-col justify-end items-center pb-2 relative group">
          <div class="w-full bg-emerald-500 rounded-t-lg h-full"></div>
          <span class="text-[10px] text-slate-300 font-bold mt-2 font-mono">Oct</span>
        </div>
      </div>
    </div>

    <!-- SPENDING BREAKDOWN BY CATEGORY -->
    <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 space-y-4">
      <h3 class="font-bold text-white text-sm flex items-center gap-2 border-b border-slate-800 pb-3">
        <i class="fa-solid fa-pie-chart text-indigo-400"></i> Category Allocation
      </h3>
      <div class="space-y-3 text-xs">
        <div>
          <div class="flex justify-between font-semibold mb-1 text-slate-300">
            <span>Food & Dining</span> <span class="text-indigo-400">42%</span>
          </div>
          <div class="w-full bg-slate-950 h-2 rounded-full overflow-hidden">
            <div class="bg-indigo-600 h-full rounded-full" style="width: 42%;"></div>
          </div>
        </div>
        <div>
          <div class="flex justify-between font-semibold mb-1 text-slate-300">
            <span>Tech & SaaS</span> <span class="text-indigo-400">28%</span>
          </div>
          <div class="w-full bg-slate-950 h-2 rounded-full overflow-hidden">
            <div class="bg-emerald-500 h-full rounded-full" style="width: 28%;"></div>
          </div>
        </div>
        <div>
          <div class="flex justify-between font-semibold mb-1 text-slate-300">
            <span>Travel & Leisure</span> <span class="text-indigo-400">18%</span>
          </div>
          <div class="w-full bg-slate-950 h-2 rounded-full overflow-hidden">
            <div class="bg-amber-500 h-full rounded-full" style="width: 18%;"></div>
          </div>
        </div>
        <div>
          <div class="flex justify-between font-semibold mb-1 text-slate-300">
            <span>Subscriptions</span> <span class="text-indigo-400">12%</span>
          </div>
          <div class="w-full bg-slate-950 h-2 rounded-full overflow-hidden">
            <div class="bg-purple-500 h-full rounded-full" style="width: 12%;"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- LEDGER & VAULTS GRID -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- TRANSACTION LEDGER -->
    <div class="lg:col-span-2 p-6 rounded-3xl bg-slate-900/60 border border-slate-800 space-y-6">
      <div class="flex items-center justify-between border-b border-slate-800 pb-4">
        <h3 class="font-bold text-white text-sm flex items-center gap-2">
          <i class="fa-solid fa-list-check text-indigo-400"></i> Recent Financial Ledger
        </h3>
        <span class="text-[10px] font-bold text-slate-400 uppercase">Real-time sync</span>
      </div>

      <div class="space-y-3">
        <% if @transactions.any? %>
          <% @transactions.each do |tx| %>
            <div class="flex items-center justify-between p-4 rounded-2xl bg-slate-950/60 border border-slate-800/80 hover:border-slate-700 transition">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl <%= tx.tx_type == 'Income' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-400 border border-rose-500/20' %> flex items-center justify-center font-bold">
                  <i class="fa-solid <%= tx.tx_type == 'Income' ? 'fa-arrow-down' : 'fa-arrow-up' %>"></i>
                </div>
                <div>
                  <h4 class="font-bold text-white text-xs"><%= tx.title %></h4>
                  <p class="text-[10px] text-slate-400"><%= tx.created_at.strftime("%b %d, %Y - %H:%M") %></p>
                </div>
              </div>
              <div class="text-right font-mono">
                <p class="font-bold text-xs <%= tx.tx_type == 'Income' ? 'text-emerald-400' : 'text-slate-200' %>">
                  <%= tx.tx_type == 'Income' ? '+' : '-' %>$<%= sprintf('%.2f', tx.amount.to_f) %>
                </p>
                <form action="/transactions/<%= tx.id %>" method="POST" class="inline">
                  <input type="hidden" name="_method" value="DELETE">
                  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                  <button type="submit" class="text-[10px] text-rose-400 hover:underline cursor-pointer">Remove</button>
                </form>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-slate-500 text-xs text-center py-6">No recent transactions recorded in the ledger.</p>
        <% end %>
      </div>
    </div>

    <!-- VAULTS & QUICK TRANSACTION FORM -->
    <div class="space-y-6">
      
      <!-- WALLETS / VAULTS CARD -->
      <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <h3 class="font-bold text-white text-sm flex items-center gap-2">
            <i class="fa-solid fa-vault text-indigo-400"></i> Connected Vaults
          </h3>
          <button onclick="openWalletModal()" class="text-xs text-indigo-400 hover:underline cursor-pointer font-bold">+ New Vault</button>
        </div>
        <div class="space-y-3 font-mono">
          <% if @wallets.any? %>
            <% @wallets.each do |w| %>
              <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950 border border-slate-800 text-xs">
                <span class="text-slate-300 font-sans font-bold"><%= w.name %></span>
                <span class="text-emerald-400 font-bold">$<%= sprintf('%.2f', w.balance.to_f) %></span>
              </div>
            <% end %>
          <% else %>
            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950 border border-slate-800 text-xs">
              <span class="text-slate-300 font-sans font-bold">Primary Vault</span>
              <span class="text-emerald-400 font-bold">$142,850.00</span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- ADD TRANSACTION FORM -->
      <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 space-y-4">
        <h3 class="font-bold text-white text-sm flex items-center gap-2 border-b border-slate-800 pb-3">
          <i class="fa-solid fa-plus-circle text-indigo-400"></i> Quick Transaction
        </h3>
        
        <form action="/transactions" method="POST" class="space-y-3 text-xs">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          
          <div class="space-y-1">
            <label class="text-slate-300 font-semibold">Title / Description</label>
            <input type="text" name="title" placeholder="e.g. Client Payment" required class="w-full px-3 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-indigo-500">
          </div>

          <div class="space-y-1">
            <label class="text-slate-300 font-semibold">Amount ($)</label>
            <input type="number" step="0.01" name="amount" placeholder="250.00" required class="w-full px-3 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white font-mono focus:outline-none focus:border-indigo-500">
          </div>

          <div class="space-y-1">
            <label class="text-slate-300 font-semibold">Type</label>
            <select name="tx_type" class="w-full px-3 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-indigo-500 font-bold">
              <option value="Income">Income (+)</option>
              <option value="Expense">Expense (-)</option>
            </select>
          </div>

          <button type="submit" class="w-full py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold transition shadow-lg shadow-indigo-600/30 cursor-pointer mt-2">
            Commit Movement
          </button>
        </form>
      </div>

    </div>

  </div>

</div>

<!-- CREATE WALLET / VAULT MODAL -->
<div id="walletModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden">
  <div class="max-w-md w-full mx-4 p-8 rounded-3xl bg-slate-900 border border-slate-800 shadow-2xl space-y-6">
    <div class="flex items-center justify-between border-b border-slate-800 pb-4">
      <h3 class="text-base font-black text-white flex items-center gap-2">
        <i class="fa-solid fa-vault text-emerald-500"></i> Add New Vault / Wallet
      </h3>
      <button onclick="closeWalletModal()" class="text-slate-400 hover:text-white cursor-pointer"><i class="fa-solid fa-xmark text-lg"></i></button>
    </div>

    <%= form_with url: wallets_path, local: true, class: "space-y-4 text-xs" do |f| %>
      <div class="space-y-1">
        <label class="font-semibold text-slate-300">Vault Name</label>
        <%= f.text_field :name, placeholder: "e.g. Crypto Treasury, Offshore Account", required: true, class: "w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-emerald-500" %>
      </div>

      <div class="space-y-1">
        <label class="font-semibold text-slate-300">Initial Balance ($)</label>
        <%= f.number_field :balance, step: "0.01", placeholder: "10000.00", required: true, class: "w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white font-mono focus:outline-none focus:border-emerald-500" %>
      </div>

      <div class="space-y-1">
        <label class="font-semibold text-slate-300">Currency</label>
        <select name="currency" class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white font-bold focus:outline-none focus:border-emerald-500">
          <option value="USD">USD ($)</option>
          <option value="AED">AED (د.إ)</option>
          <option value="EUR">EUR (€)</option>
        </select>
      </div>

      <%= f.submit "Initialize Vault", class: "w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold transition shadow-lg shadow-emerald-600/30 cursor-pointer mt-4" %>
    <% end %>
  </div>
</div>

<script>
  function openWalletModal() {
    document.getElementById('walletModal').classList.remove('hidden');
  }
  function closeWalletModal() {
    document.getElementById('walletModal').classList.add('hidden');
  }
</script>

<div class="max-w-2xl mx-auto px-6 py-12 space-y-6">
  <div class="p-8 rounded-3xl bg-slate-900 border border-slate-800 shadow-xl space-y-6 text-xs">
    <div class="flex items-center justify-between border-b border-slate-800 pb-4">
      <h1 class="text-lg font-black text-white flex items-center gap-2"><i class="fa-solid fa-gear text-indigo-400"></i> Account Settings</h1>
      <a href="/profile" class="text-slate-400 hover:text-white font-bold">&larr; Back</a>
    </div>
    <div class="space-y-4">
      <div class="space-y-1">
        <label class="font-semibold text-slate-300">Display Name</label>
        <input type="text" value="<%= @current_user&.name || 'alex bee' %>" class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white font-mono" readonly>
      </div>
      <div class="space-y-1">
        <label class="font-semibold text-slate-300">Email Address</label>
        <input type="email" value="<%= @current_user&.email || 'alex.bee@wealthpulse.pro' %>" class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white font-mono" readonly>
      </div>
      <div class="space-y-1">
        <label class="font-semibold text-slate-300">Security Encryption</label>
        <div class="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-bold">
          Zero-Knowledge AES-256 Active
        </div>
      </div>
    </div>
  </div>
</div>

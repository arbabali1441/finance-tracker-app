<div class="max-w-3xl mx-auto px-6 py-12 space-y-8">
  <div class="p-8 rounded-3xl bg-slate-900/90 border border-slate-800 shadow-2xl space-y-8">
    
    <!-- HEADER -->
    <div class="flex items-center gap-5 border-b border-slate-800 pb-6">
      <div class="w-16 h-16 rounded-2xl bg-indigo-600 flex items-center justify-center font-bold text-white text-2xl shadow-lg shadow-indigo-600/30">
        <%= @current_user ? @current_user.name[0].upcase : 'A' %>
      </div>
      <div class="space-y-1">
        <h1 class="text-2xl font-black text-white"><%= @current_user ? @current_user.name : 'alex bee' %></h1>
        <p class="text-xs text-slate-400 font-mono"><%= @current_user ? @current_user.email : 'alex.bee@wealthpulse.pro' %></p>
      </div>
    </div>

    <!-- PROFILE OPTIONS LIST (MATCHING REQUESTED OPTIONS) -->
    <div class="space-y-3 text-xs">
      <a href="/settings" class="flex items-center justify-between p-4 rounded-2xl bg-slate-950/60 border border-slate-800 hover:border-indigo-500/50 transition group">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-indigo-600/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400 group-hover:scale-105 transition">
            <i class="fa-solid fa-gear"></i>
          </div>
          <div>
            <h3 class="font-bold text-white text-sm">Settings</h3>
            <p class="text-slate-400 text-[11px]">Manage personal info, security, and preferences</p>
          </div>
        </div>
        <i class="fa-solid fa-chevron-right text-slate-500 group-hover:text-white transition"></i>
      </a>

      <a href="/get_premium" class="flex items-center justify-between p-4 rounded-2xl bg-slate-950/60 border border-slate-800 hover:border-amber-500/50 transition group">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 group-hover:scale-105 transition">
            <i class="fa-solid fa-crown"></i>
          </div>
          <div>
            <h3 class="font-bold text-white text-sm">Get Premium for Free</h3>
            <p class="text-slate-400 text-[11px]">Unlock institutional tools via referral program</p>
          </div>
        </div>
        <i class="fa-solid fa-chevron-right text-slate-500 group-hover:text-white transition"></i>
      </a>

      <a href="/subscription" class="flex items-center justify-between p-4 rounded-2xl bg-slate-950/60 border border-slate-800 hover:border-emerald-500/50 transition group">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 group-hover:scale-105 transition">
            <i class="fa-solid fa-receipt"></i>
          </div>
          <div>
            <h3 class="font-bold text-white text-sm">Subscription</h3>
            <p class="text-slate-400 text-[11px]">Pro Trader Tier active ($49/mo billing)</p>
          </div>
        </div>
        <i class="fa-solid fa-chevron-right text-slate-500 group-hover:text-white transition"></i>
      </a>

      <a href="/support" class="flex items-center justify-between p-4 rounded-2xl bg-slate-950/60 border border-slate-800 hover:border-indigo-500/50 transition group">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-indigo-600/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400 group-hover:scale-105 transition">
            <i class="fa-solid fa-headset"></i>
          </div>
          <div>
            <h3 class="font-bold text-white text-sm">Support</h3>
            <p class="text-slate-400 text-[11px]">24/7 Priority concierge assistance</p>
          </div>
        </div>
        <i class="fa-solid fa-chevron-right text-slate-500 group-hover:text-white transition"></i>
      </a>

      <a href="/logout" class="flex items-center justify-between p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 hover:border-rose-500/40 transition group">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-rose-500/20 flex items-center justify-center text-rose-400 group-hover:scale-105 transition">
            <i class="fa-solid fa-right-from-bracket"></i>
          </div>
          <div>
            <h3 class="font-bold text-rose-400 text-sm">Log Out</h3>
            <p class="text-slate-400 text-[11px]">Safely terminate active cryptographic session</p>
          </div>
        </div>
        <i class="fa-solid fa-chevron-right text-slate-500 group-hover:text-white transition"></i>
      </a>
    </div>

    <div class="text-center">
      <a href="/" class="text-xs font-bold text-indigo-400 hover:underline">&larr; Return to Dashboard</a>
    </div>

  </div>
</div>

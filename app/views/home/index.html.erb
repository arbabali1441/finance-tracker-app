<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <title>WealthPulse Pro - Next-Gen Financial Command Center</title>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-indigo-500 selection:text-white min-h-screen flex flex-col">

  <!-- TOP NAVIGATION BAR -->
  <nav class="sticky top-0 z-50 bg-slate-900/80 backdrop-blur-md border-b border-slate-800/80 px-6 py-4 transition-all duration-200">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-indigo-500 to-cyan-400 flex items-center justify-center shadow-lg shadow-indigo-500/20">
          <i class="fa-solid font-bold fa-chart-line text-white text-lg"></i>
        </div>
        <span class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">
          WealthPulse <span class="text-indigo-400 font-mono text-xs px-2 py-0.5 rounded border border-indigo-500/30 bg-indigo-500/10">PRO</span>
        </span>
      </div>

      <div class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-300">
        <a href="#features" class="hover:text-indigo-400 transition-colors">Features</a>
        <a href="#dashboard" class="hover:text-indigo-400 transition-colors">Dashboard</a>
        <a href="#analytics" class="hover:text-indigo-400 transition-colors">Analytics</a>
        <a href="/#faqs">FAQs</a>
      </div>

      <div class="flex items-center space-x-4">
        <button id="panicBtn" onclick="togglePanicMode()" class="px-3 py-1.5 rounded-lg border border-red-500/30 text-red-400 bg-red-500/10 hover:bg-red-500/20 text-xs font-semibold flex items-center gap-2 transition-all">
          <i class="fa-solid fa-eye-slash"></i> Panic Blur
        </button>
        <select id="personaSelect" onchange="changePersona(this.value)" class="bg-slate-800 border border-slate-700 text-xs rounded-lg px-2.5 py-1.5 text-slate-200 focus:ring-1 focus:ring-indigo-500">
          <option value="wallstreet">🎩 Wall Street Persona</option>
          <option value="drill">🎖️ Drill Sergeant</option>
          <option value="hypeman">🔥 Hype Man</option>
        </select>
      </div>
    </div>
  </nav>

  <!-- HERO SECTION -->
  

  <!-- AI ADVISOR COACH BAR -->
  <section class="bg-indigo-950/40 border-y border-indigo-900/30 py-3 px-6">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-3">
        <span class="w-7 h-7 rounded-lg bg-indigo-600/30 text-indigo-300 flex items-center justify-center font-bold text-sm">
          <i class="fa-solid fa-robot"></i>
        </span>
        <div>
          <span class="font-bold text-indigo-300 mr-2" id="advisorTitle">WALL STREET ADVISOR:</span>
          <span class="text-slate-300" id="advisorText">"Your current liquidity allocation provides strong protection. Recommend sweeping 5% idle cash into yield vaults."</span>
        </div>
      </div>
      <button onclick="generateInsight()" class="px-3 py-1 bg-indigo-600 hover:bg-indigo-500 text-white font-medium rounded-md transition-all shadow">
        Re-Analyze Ledger
      </button>
    </div>
  </section>

  <!-- MAIN APP INTERFACE -->
  <main id="dashboard" class="max-w-7xl mx-auto px-6 py-10 w-full space-y-10">

    <!-- TRANSACTIONS & ANALYTICS ROW -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- LEFT: LEDGER & ADD TRANSACTION -->
      <div class="lg:col-span-2 space-y-6">
        
        <!-- NEW TRANSACTION FORM -->
        <div class="p-6 rounded-2xl bg-slate-900/70 border border-slate-800 shadow-xl space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-square-plus text-indigo-400"></i> Log Financial Movement
            </h2>
            <span class="text-xs text-slate-400">Instant Ledger Entry</span>
          </div>

          <form id="txForm" onsubmit="addTransaction(event)" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1">Title / Merchant</label>
              <input type="text" id="txTitle" required placeholder="e.g. Sobha Rent, Starbucks" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1">Amount ($)</label>
              <input type="number" step="0.01" id="txAmount" required placeholder="0.00" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1">Type</label>
              <select id="txType" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
                <option value="expense">Expense (-)</option>
                <option value="income">Income (+)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-400 mb-1">Mood Tag</label>
              <select id="txMood" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-500">
                <option value="Calculated">🎯 Calculated</option>
                <option value="Impulsive">⚡ Impulsive</option>
                <option value="Essential">🏡 Essential</option>
                <option value="Investment">📈 Investment</option>
              </select>
            </div>
            <div class="sm:col-span-2 md:col-span-4 flex justify-end gap-2 pt-2">
              <button type="submit" class="w-full sm:w-auto px-5 py-2.5 bg-gradient-to-r from-indigo-600 to-cyan-600 hover:from-indigo-500 hover:to-cyan-500 text-white text-xs font-bold rounded-lg shadow-lg shadow-indigo-600/20 transition-all">
                + Commit Transaction
              </button>
            </div>
          </form>
        </div>

        <!-- RECENT TRANSACTIONS TABLE -->
        <div class="p-6 rounded-2xl bg-slate-900/70 border border-slate-800 shadow-xl space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-list-check text-indigo-400"></i> Active Ledger Stream
            </h2>
            <span class="text-xs text-slate-400">Live Synchronized</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-300">
              <thead class="bg-slate-950/60 text-slate-400 uppercase tracking-wider border-b border-slate-800">
                <tr>
                  <th class="p-3">Title</th>
                  <th class="p-3">Type</th>
                  <th class="p-3">Mood</th>
                  <th class="p-3 text-right">Amount</th>
                  <th class="p-3 text-center">Action</th>
                </tr>
              </thead>
              <tbody id="txTableBody" class="divide-y divide-slate-800/60 font-medium">
                <!-- JS populated -->
              </tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- RIGHT: LIVE CHARTS & MULTI-CURRENCY -->
      <div class="space-y-6">
        
        <!-- CHART CARD -->
        <div class="p-6 rounded-2xl bg-slate-900/70 border border-slate-800 shadow-xl space-y-4">
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-chart-pie text-cyan-400"></i> Category Allocation
          </h3>
          <div class="relative h-52 flex items-center justify-center">
            <canvas id="categoryChart"></canvas>
          </div>
        </div>

        <!-- MULTI-CURRENCY LEDGER -->
        <div class="p-6 rounded-2xl bg-slate-900/70 border border-slate-800 shadow-xl space-y-4">
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-coins text-amber-400"></i> Multi-Currency Vaults
          </h3>
          <div class="space-y-3 text-xs">
            <div class="flex justify-between items-center p-2.5 rounded-lg bg-slate-950/60 border border-slate-800">
              <span class="font-bold text-slate-200">🇺🇸 USD Account</span>
              <span class="font-mono font-bold text-emerald-400 blur-target">$82,400.00</span>
            </div>
            <div class="flex justify-between items-center p-2.5 rounded-lg bg-slate-950/60 border border-slate-800">
              <span class="font-bold text-slate-200">🇦🇪 AED Vault (Dubai)</span>
              <span class="font-mono font-bold text-slate-300 blur-target">185,000.00 AED</span>
            </div>
            <div class="flex justify-between items-center p-2.5 rounded-lg bg-slate-950/60 border border-slate-800">
              <span class="font-bold text-slate-200">₿ Crypto Treasury (BTC)</span>
              <span class="font-mono font-bold text-amber-400 blur-target">0.85 BTC (~$55,250)</span>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- FAQS SECTION -->
    <section id="faqs" class="pt-10 border-t border-slate-800 space-y-6">
      <div class="text-center space-y-2">
        <h2 class="text-2xl font-bold text-white">Frequently Asked Questions</h2>
        <p class="text-slate-400 text-xs">Everything you need to know about WealthPulse Pro</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-5xl mx-auto text-xs">
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h4 class="font-bold text-indigo-300">How does the Panic Blur mode work?</h4>
          <p class="text-slate-400 leading-relaxed">Clicking 'Panic Blur' instantly obscures all sensitive dollar amounts on screen using web CSS filters, ensuring privacy in public coffee shops or coworking spaces.</p>
        </div>
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h4 class="font-bold text-indigo-300">What are AI Advisor Personas?</h4>
          <p class="text-slate-400 leading-relaxed">You can customize how your financial feedback is delivered—ranging from Wall Street analytical advice to strict Drill Sergeant budget enforcement.</p>
        </div>
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h4 class="font-bold text-indigo-300">Is multi-currency supported?</h4>
          <p class="text-slate-400 leading-relaxed">Yes, WealthPulse Pro seamlessly formats and calculates totals across USD, AED, EUR, and digital assets like Bitcoin in real-time.</p>
        </div>
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h4 class="font-bold text-indigo-300">Is my financial data encrypted?</h4>
          <p class="text-slate-400 leading-relaxed">All ledger entries adhere to strict client-side encryption protocols before being synchronized with your isolated databases.</p>
        </div>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="mt-auto border-t border-slate-800 bg-slate-950 py-8 px-6 text-xs text-slate-500">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center space-x-2">
        <div class="w-6 h-6 rounded bg-indigo-600 flex items-center justify-center text-white font-bold text-xs">W</div>
        <span class="font-bold text-slate-300">WealthPulse Pro Engine</span>
        <span>© 2026 All Rights Reserved.</span>
      </div>
      <div class="flex space-x-6 text-slate-400">
        <a href="#" class="hover:text-indigo-400">Privacy Policy</a>
        <a href="#" class="hover:text-indigo-400">Terms of Service</a>
        <a href="#" class="hover:text-indigo-400">API Documentation</a>
      </div>
    </div>
  </footer>

  <!-- DYNAMIC INTERACTIVE LOGIC SCRIPT -->
  <script>
    let transactions = [
      { id: 1, title: 'Sobha Hartland Residence', amount: 3200, type: 'expense', mood: 'Essential' },
      { id: 2, title: 'SaaS Client Retainer', amount: 9500, type: 'income', mood: 'Investment' },
      { id: 3, title: 'Trading & Equity Gain', amount: 2100, type: 'income', mood: 'Calculated' },
      { id: 4, title: 'Tech Equipment Upgrade', amount: 450, type: 'expense', mood: 'Impulsive' }
    ];

    let categoryChart = null;

    function renderLedger() {
      const tbody = document.getElementById('txTableBody');
      tbody.innerHTML = '';

      transactions.forEach(tx => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-800/40 transition-colors';
        tr.innerHTML = `
          <td class="p-3 font-semibold text-slate-200">${tx.title}</td>
          <td class="p-3">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${tx.type === 'income' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-red-500/10 text-red-400 border border-red-500/20'}">
              ${tx.type.toUpperCase()}
            </span>
          </td>
          <td class="p-3"><span class="text-slate-400">${tx.mood}</span></td>
          <td class="p-3 text-right font-mono font-bold blur-target ${tx.type === 'income' ? 'text-emerald-400' : 'text-slate-200'}">
            ${tx.type === 'income' ? '+' : '-'}$${tx.amount.toFixed(2)}
          </td>
          <td class="p-3 text-center">
            <button onclick="deleteTx(${tx.id})" class="text-slate-500 hover:text-red-400 transition-colors">
              <i class="fa-solid fa-trash-can"></i>
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      updateChart();
    }

    function addTransaction(e) {
      e.preventDefault();
      const title = document.getElementById('txTitle').value;
      const amount = parseFloat(document.getElementById('txAmount').value);
      const type = document.getElementById('txType').value;
      const mood = document.getElementById('txMood').value;

      transactions.unshift({ id: Date.now(), title, amount, type, mood });
      document.getElementById('txForm').reset();
      renderLedger();
    }

    function deleteTx(id) {
      transactions = transactions.filter(t => t.id !== id);
      renderLedger();
    }

    function togglePanicMode() {
      document.querySelectorAll('.blur-target').forEach(el => {
        el.classList.toggle('blur-md');
      });
    }

    function changePersona(val) {
      const title = document.getElementById('advisorTitle');
      const text = document.getElementById('advisorText');
      if (val === 'drill') {
        title.innerText = "DRILL SERGEANT:";
        text.innerText = '"LISTEN UP! Cut non-essential dining expenses now and increase your liquid runway immediately!"';
      } else if (val === 'hypeman') {
        title.innerText = "HYPE MAN:";
        text.innerText = '"LETS GOOO! You are crushing your cash flow goals this month! Keep stacking those assets!"';
      } else {
        title.innerText = "WALL STREET ADVISOR:";
        text.innerText = '"Your current liquidity allocation provides strong protection. Recommend sweeping 5% idle cash into yield vaults."';
      }
    }

    function updateChart() {
      const ctx = document.getElementById('categoryChart').getContext('2d');
      const expenses = transactions.filter(t => t.type === 'expense').reduce((acc, t) => acc + t.amount, 0);
      const income = transactions.filter(t => t.type === 'income').reduce((acc, t) => acc + t.amount, 0);

      if (categoryChart) categoryChart.destroy();

      categoryChart = new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: ['Total Income', 'Total Expenses'],
          datasets: [{
            data: [income, expenses],
            backgroundColor: ['#10b981', '#f43f5e'],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { labels: { color: '#94a3b8', font: { size: 10 } } }
          }
        }
      });
    }

    // Initial Load
    document.addEventListener('DOMContentLoaded', () => {
      renderLedger();
    });
  </script>






</body>
</html>
